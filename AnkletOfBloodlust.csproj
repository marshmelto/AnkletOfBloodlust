<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>preview</LangVersion>
    <AssemblyName>AnkletOfBloodlust</AssemblyName>
    <RootNamespace>AnkletOfBloodlust</RootNamespace>
    <!-- Keep in sync with PluginVersion in AnkletOfBloodlustPlugin.cs and Thunderstore/manifest.json -->
    <Version>1.1.0</Version>
    <ThunderstoreTeam>marshmeltoo</ThunderstoreTeam>
    <!-- MMHOOK.RoR2 (pulled in by R2API) targets .NET Framework; harmless for a BepInEx plugin -->
    <NoWarn>$(NoWarn);NU1701</NoWarn>

    <RestoreAdditionalProjectSources>
      https://api.nuget.org/v3/index.json;
      https://nuget.bepinex.dev/v3/index.json
    </RestoreAdditionalProjectSources>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Analyzers" Version="1.0.*">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>

    <PackageReference Include="BepInEx.Core" Version="5.4.21" />
    <!-- Same versions as the dependencies in Thunderstore/manifest.json -->
    <PackageReference Include="R2API.Core" Version="5.3.0" />
    <PackageReference Include="R2API.ContentManagement" Version="1.0.11" />
    <PackageReference Include="R2API.Items" Version="1.0.8" />
    <PackageReference Include="R2API.Language" Version="1.1.0" />
    <PackageReference Include="R2API.RecalculateStats" Version="1.6.6" />

    <PackageReference Include="UnityEngine.Modules" Version="2021.3.33" IncludeAssets="compile" />
    <PackageReference Include="RiskOfRain2.GameLibs" Version="1.4.1-r.0" />
  </ItemGroup>

  <!-- The AssetBundle (model prefab + icons), built by the Unity project's Anklet > Build AssetBundle
       menu, ships next to the DLL -->
  <ItemGroup>
    <ModFile Include="$(TargetPath);Assets\ankletofbloodlust" />
    <ThunderstoreFile Include="Thunderstore\manifest.json;Thunderstore\README.md;Thunderstore\CHANGELOG.md;Thunderstore\icon.png" />
  </ItemGroup>

  <!-- Release builds also produce the zip to upload to Thunderstore, in dist/ -->
  <Target Name="PackageThunderstore" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <PackageStaging>$(MSBuildProjectDirectory)\obj\thunderstore</PackageStaging>
      <PackageZip>$(MSBuildProjectDirectory)\dist\$(ThunderstoreTeam)-$(AssemblyName)-$(Version).zip</PackageZip>
    </PropertyGroup>
    <RemoveDir Directories="$(PackageStaging)" />
    <Copy SourceFiles="@(ThunderstoreFile);@(ModFile)" DestinationFolder="$(PackageStaging)" />
    <MakeDir Directories="$(MSBuildProjectDirectory)\dist" />
    <ZipDirectory SourceDirectory="$(PackageStaging)" DestinationFile="$(PackageZip)" Overwrite="true" />
    <Message Importance="high" Text="Thunderstore package: $(PackageZip)" />
  </Target>

</Project>
